# Production — https://www.tempempire.store (canonical)
# Copy to Vercel Project → Settings → Environment Variables

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tempempire?sslmode=require"

AUTH_TRUST_HOST="true"
AUTH_SECRET="replace-with-long-random-secret"
AUTH_URL="https://www.tempempire.store"

NEXT_PUBLIC_APP_NAME="Temp Empire"
NEXT_PUBLIC_APP_URL="https://www.tempempire.store"

# Turn off mocks when real providers are wired
USE_MOCK_PROVIDERS="true"

GLOBAL_PRICE_MARKUP_PERCENT="20"
RATE_LIMIT_RPM="60"

SMS_ACTIVATE_API_KEY=""
FIVESIM_API_KEY=""
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

SEED_ADMIN_EMAIL="admin@tempempire.store"
SEED_ADMIN_PASSWORD="change-me-immediately"
SEED_DEMO_EMAIL="demo@tempempire.store"
SEED_DEMO_PASSWORD="change-me-immediately"
