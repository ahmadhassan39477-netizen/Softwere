{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/prisma-prepare.mjs --push && next build",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tempempire.store" }],
      "destination": "https://www.tempempire.store/:path*",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "tempempire.store" }],
      "destination": "https://www.tempempire.store/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.tempempire.store" },
        { "type": "header", "key": "x-forwarded-proto", "value": "http" }
      ],
      "destination": "https://www.tempempire.store/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sms-poll",
      "schedule": "0 12 * * *"
    }
  ]
}
