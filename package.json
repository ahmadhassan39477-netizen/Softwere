{
  "name": "temp-empire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H :: -p 3000",
    "build": "node scripts/prisma-prepare.mjs --push && next build",
    "start": "next start -H :: -p 3000",
    "lint": "eslint",
    "db:generate": "node scripts/prisma-prepare.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/prisma-prepare.mjs --push && tsx prisma/seed.ts",
    "db:generate:prod": "prisma generate --schema=prisma/schema.postgres.prisma",
    "db:push:prod": "prisma db push --schema=prisma/schema.postgres.prisma",
    "db:promote-owners": "tsx scripts/promote-owner-admins.ts",
    "postinstall": "node scripts/prisma-prepare.mjs",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "brand:icons": "node scripts/generate-brand-icons.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@tanstack/react-query": "^5.104.2",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "nanoid": "^5.1.5",
    "next": "15.5.27",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
