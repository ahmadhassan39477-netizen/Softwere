# Database — SQLite for local mocks; PostgreSQL in production (see prisma/schema.postgres.prisma)
DATABASE_URL="file:./dev.db"
# Production example:
# DATABASE_URL="postgresql://user:pass@host:5432/tempempire?sslmode=require"

# NextAuth / Auth.js
# Local / quick-tunnel demos: leave AUTH_URL unset; AUTH_TRUST_HOST=true is enough.
# Production (tempempire.store): ALWAYS set both to the canonical host.
AUTH_TRUST_HOST="true"
AUTH_SECRET="generate-a-long-random-secret"
# AUTH_URL="https://www.tempempire.store"
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# NEXT_PUBLIC_SUPPORT_EMAIL="support@tempempire.store"

# App
NEXT_PUBLIC_APP_NAME="Temp Empire"
# NEXT_PUBLIC_APP_URL="https://www.tempempire.store"
NEXT_PUBLIC_APP_URL=""
USE_MOCK_PROVIDERS="true"

# SMS wholesale providers (stubbed when USE_MOCK_PROVIDERS=true)
SMS_ACTIVATE_API_KEY=""
FIVESIM_API_KEY=""
GRIZZLY_SMS_API_KEY=""
GRIZZLYSMS_API_KEY=""
SMS_MAN_API_KEY=""
# SMSBower (Server 3 Extra) — prefer Admin ProviderSetting paste; never commit real keys
SMSBOWER_API_KEY=""
# SMSBOWER_BASE_URL="https://smsbower.page/stubs/handler_api.php"

# Temp Mail Plus uses the public mail.tm API (no key). Optional host override only:
# MAILTM_API_URL="https://api.mail.tm"

# VPN & Proxy — paste Proxy Cheap API key + user/secret in Admin, not here. No key in git.

# Payments (stubbed)
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
COINPAYMENTS_PUBLIC_KEY=""
COINPAYMENTS_PRIVATE_KEY=""
CRYPTOMUS_API_KEY=""
CRYPTOMUS_MERCHANT_ID=""
BTCPAY_SERVER_URL=""
BTCPAY_API_KEY=""

# Markup
GLOBAL_PRICE_MARKUP_PERCENT="20"

# Rate limiting (in-memory mock; use Redis URL in production)
REDIS_URL=""
RATE_LIMIT_RPM="60"

# Seed admin
SEED_ADMIN_EMAIL="admin@tempempire.com"
SEED_ADMIN_PASSWORD="admin1234"
SEED_DEMO_EMAIL="demo@tempempire.com"
SEED_DEMO_PASSWORD="demo1234"
