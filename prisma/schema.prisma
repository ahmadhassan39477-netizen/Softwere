generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum Platform {
  FACEBOOK
  EBAY
  ETSY
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model User {
  id        String             @id @default(cuid())
  email     String             @unique
  password  String
  name      String
  plan      Plan               @default(FREE)
  accounts  ConnectedAccount[]
  products  Product[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model ConnectedAccount {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    Platform  @default(FACEBOOK)
  pageName    String
  pageId      String
  accessToken String
  profilePic  String?
  catalogId   String?
  aiAutoReply Boolean   @default(false)
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([platform, pageId])
  @@index([userId])
}

model Product {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  price       Decimal          @db.Decimal(12, 2)
  category    String
  condition   ProductCondition
  images      String[]
  sku         String
  stock       Int              @default(0)
  status      ProductStatus    @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, sku])
  @@index([userId, status])
}

model Message {
  id                 String           @id @default(cuid())
  connectedAccountId String
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  senderId           String
  messageText        String
  timestamp          DateTime         @default(now())
  isFromUser         Boolean
  platformMessageId  String?          @unique

  @@index([connectedAccountId, senderId, timestamp])
}
